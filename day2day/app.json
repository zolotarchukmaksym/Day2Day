{
  "expo": {
    "name": "Daily Planner",
    "slug": "daily-planner",
    "scheme": "dailyplanner",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1B1033"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yourcompany.dailyplanner"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1B1033"
      },
      "package": "com.yourcompany.dailyplanner"
    },
    "plugins": ["expo-router"],
    "extra": {
      "router": { "origin": false }
    }
  }
}
